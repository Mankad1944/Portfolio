# ── Server-specific ignores ───────────────────────────────────
# (Root .gitignore covers node_modules, .env etc.)

# Local env overrides
.env
.env.local
.env.*.local

# SSL certs (auto-generated by generate-ssl.js for local dev)
ssl/
*.pem
*.key
*.crt

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
