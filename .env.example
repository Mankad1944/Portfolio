# ============================================================
# .env.example — Copy to .env and fill in real values
# NEVER commit your actual .env file!
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas (get connection string from atlas.mongodb.com) ──
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio_vanshil?retryWrites=true&w=majority

# ── HTTPS (local dev only) ───────────────────────────────────
# Set to true to enable self-signed HTTPS on the Express server
USE_HTTPS=false

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins (leave blank to allow all in dev)
# ALLOWED_ORIGINS=https://vanshilmankad.vercel.app,http://localhost:5173

# ── Admin (optional) ─────────────────────────────────────────
# ADMIN_SECRET=change_this_to_something_strong

# ── Social Links (optional — can also be set via Admin Dashboard) ──
LINKEDIN_ID=https://www.linkedin.com/in/vanshil-mankad-1a6684343/
GITHUB_ID=https://github.com/Mankad1944/
BRAND_NAME=MANKAD
